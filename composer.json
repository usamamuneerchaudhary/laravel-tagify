{
    "name": "usamamuneerchaudhary/laravel-tagify",
    "description": "Attach, detach, and query tags on Eloquent models using a polymorphic relationship.",
    "keywords": ["laravel", "tags", "tagging", "taggable", "eloquent"],
    "homepage": "https://github.com/usamamuneerchaudhary/laravel-tagify",
    "license": "MIT",
    "authors": [
        {
            "name": "Usama Muneer",
            "email": "hello@usamamuneer.me",
            "homepage": "https://usamamuneer.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "usamamuneerchaudhary/laravel-slipway": "^1.8"
    },
    "suggest": {
        "ext-intl": "Improves transliteration quality when normalizing non-Latin tag names."
    },
    "autoload": {
        "psr-4": {
            "Usamamuneerchaudhary\\LaravelTagify\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "slipway:compile": "vendor/bin/testbench slipway:compile",
        "slipway:check": "vendor/bin/testbench slipway:check"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Usamamuneerchaudhary\\LaravelTagify\\TagifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
